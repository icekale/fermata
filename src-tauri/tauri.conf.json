{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fermata",
  "version": "2.2.0",
  "identifier": "app.fermata.timer",
  "build": {
    "beforeBuildCommand": "npm run build-renderer",
    "beforeDevCommand": "npm run start-renderer-dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}